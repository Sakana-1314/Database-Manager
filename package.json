    "@types/pg": "^8.11.10",
    "@types/ssh2": "^1.15.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.24.2",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
