{
  "name": "@edgeone-db/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:frontend": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "build:backend": "node node-functions/build.mjs",
    "assemble": "node scripts/build.mjs --assemble",
    "deploy": "npm run build && npm run assemble",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:backend": "cd node-functions && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "bson": "^6.10.1",
    "jose": "^5.9.6",
    "mongodb": "^6.11.0",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "ssh2": "^1.16.0",
    "@codemirror/autocomplete": "^6.18.3",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.35.0",
    "codemirror": "^6.0.1",
    "idb": "^8.0.0",
    "naive-ui": "^2.40.3",
    "papaparse": "^5.4.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
